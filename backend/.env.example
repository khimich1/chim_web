# PostgreSQL (app DB) — used from Task 1+
# Local dev (no PostgreSQL): sqlite+aiosqlite:///./data/app.db
# Docker / production: postgresql+asyncpg://user:pass@localhost:5432/chemistry
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Content SQLite (read-only), paths relative to backend/ or absolute
CONTENT_EGE_DB_PATH=../test_ege.db
CONTENT_OGE_DB_PATH=../test_oge.db
CONTENT_LECTURES_DB_PATH=../prepared_lectures.db

# Auth — used from Task 4+
# Use a long random secret in production (>= 32 bytes), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limits (slowapi) — login brute-force + tutor LLM cost
AUTH_LOGIN_RATE_LIMIT=10/15minutes
TUTOR_MESSAGE_RATE_LIMIT=30/minute
LEADS_RATE_LIMIT=5/minute

# Marketing leads → Google Sheets (Apps Script webhook URL)
GOOGLE_SHEETS_WEBHOOK_URL=

# Auth cookie. COOKIE_SECURE must be true behind HTTPS in production.
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — used from Task 1+
# Local Next dev: http://localhost:3000
# Docker Compose (nginx): http://localhost:8080 — see repo root .env.example
CORS_ORIGINS=http://localhost:3000

# RAG index (v2+ tutor) — built via: python -m app.cli.index_rag --rebuild
# Keyword RAG works without an LLM key; hybrid embeddings still use OPENAI_API_KEY / EMBEDDING_MODEL
RAG_INDEX_PATH=backend/data/rag_index.json

# Tutor chat LLM (canonical). Switch active vendor via LLM_PROVIDER.
# DeepSeek (primary now): OpenAI-compatible API — no extra pip deps.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# GigaChat (next increment): set LLM_PROVIDER=gigachat after adapter lands;
# keeping both keys in .env is fine — only LLM_PROVIDER selects the active one.

# Legacy aliases (optional if LLM_* set). Still used by embeddings / index_rag.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_HYBRID_ENABLED=true
RAG_QUERY_REWRITE_ENABLED=true
# Textbook neuroquiz overlay after «Далее» (default off)
NEUROQUIZ_ENABLED=false
CHROMA_DIR=backend/data/chroma
